# Postgres connection string used by the running app (Supabase recommended — see docs/requirements.md).
# In production this should be the pooled/PgBouncer connection string (Supabase "Transaction pooler",
# port 6543, with ?pgbouncer=true) — serverless functions open many short-lived connections.
DATABASE_URL="postgresql://user:password@localhost:5432/jira_tracker?schema=public"

# Non-pooled connection string used only by the Prisma CLI (migrations/introspection).
# In production this should be Supabase's "Direct connection" (port 5432) — DDL doesn't
# work reliably through a transaction-mode pooler. Locally this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/jira_tracker?schema=public"

# 32+ char random secret used to encrypt Jira API tokens at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Random secret used to sign the single-user dashboard session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/sync. Generate one with: openssl rand -base64 32
CRON_SECRET=""
