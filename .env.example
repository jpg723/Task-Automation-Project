# Postgres connection string (Neon or Supabase recommended — see docs/requirements.md)
DATABASE_URL="postgresql://user:password@localhost:5432/jira_tracker?schema=public"

# 32+ char random secret used to encrypt Jira API tokens at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Random secret used to sign the single-user dashboard session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""
